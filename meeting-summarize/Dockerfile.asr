FROM vllm/vllm-openai:latest

# The official image does not ship the audio dependencies, so
# /v1/audio/transcriptions fails with "Please install vllm[audio]".
# libsndfile1 is the system library soundfile needs.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir librosa soundfile
